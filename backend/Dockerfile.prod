# Production Dockerfile for FastAPI backend + Celery worker.
#
# Build context is the REPO ROOT (not backend/) so we can also COPY
# .claude/skills/netsuite-*/ into the image — the oracle_skill_seeder reads
# those files at runtime to populate the workspace agent's RAG partitions.
#
# Usage from repo root:
#   docker build -f backend/Dockerfile.prod -t backend .
#   docker run -p 8000:8000 backend

FROM python:3.11-slim AS base

# Prevent Python from writing .pyc files and enable unbuffered output.
# ORACLE_SKILLS_ROOT tells oracle_skill_seeder where to walk for vendored
# Oracle skill content (set to /app, where we COPY them below).
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ORACLE_SKILLS_ROOT=/app

WORKDIR /app

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc libpq-dev && \
    rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY backend/pyproject.toml backend/scripts/assert_dependency_ceilings.py ./
RUN pip install --no-cache-dir . && \
    apt-get purge -y --auto-remove gcc

# Assert the INSTALLED anthropic honours the ceiling pyproject declares.
#
# What is verified, and what is not — read this before trusting either as the
# cause of a future recurrence:
#
#   VERIFIED. `main` carried an unbounded `anthropic>=0.40.0` (the ceiling
#   lived only on a feature branch), so any build from main resolved 1.0.0 on
#   an ordinary `pip install`. That alone is sufficient to reproduce the
#   outage and is the primary reason this file exists.
#
#   VERIFIED, MECHANISM UNEXPLAINED. On 2026-08-26 three digest-verified
#   deploys built from a tree that DID contain the ceiling nonetheless shipped
#   anthropic 1.0.0, and `/app/pyproject.toml` inside those images was the
#   102-line pre-ceiling file while the application code was current. A
#   rebuild with --no-cache produced the 114-line file and anthropic 0.125.0.
#   Content-addressed caching should have invalidated that layer when
#   pyproject.toml changed, so the exact mechanism is NOT established. Do not
#   assume "stale layer" and stop there — check first whether the ceiling is
#   actually present on the branch being built.
#
# Either way the failure is the same: 1.x vendors its own httpcore2, so the
# httpx.Timeout our adapters construct is foreign to it and reaches
# anyio.fail_after, which does `current_time() + delay`:
#   TypeError: unsupported operand type(s) for +: 'float' and 'Timeout'
# Every outbound LLM call dies, surfacing to users as the chat's generic
# "I wasn't able to find relevant information" — so the outage is silent at
# exactly the layer someone would investigate first.
#
# Why this duplicates the pyproject pin ON PURPOSE: a guard derived from the
# pin cannot catch the case where the pin failed to apply. The whole point is
# to be an INDEPENDENT observation of what actually got installed. A digest
# check cannot substitute — it proves which image runs, never what pip
# resolved inside it.
#
# The check lives in a FILE, not inline here, so this image and the dev
# `backend/Dockerfile` cannot drift: the first draft pasted the same assertion
# into both, and a review round pointed out the next edit would land in one and
# miss the other. Extending its table beyond anthropic is ClickUp 86bbmwwmt.
# NB: the COPY above lists two sources, so both land FLAT in /app — the
# script is at /app/assert_dependency_ceilings.py, NOT /app/scripts/. A
# `scripts/`-prefixed path here fails the build with ENOENT (caught by
# actually building the image; the script's own unit-level proof could not
# see it). `COPY backend/ .` later puts a second copy under /app/scripts/,
# which is why the runtime layout looks different from this one.
RUN python assert_dependency_ceilings.py

# Install Node.js 20 + Java (JRE) + suitecloud CLI for workspace validate/deploy.
# Pinned to major v3 of the CLI (plan's ^2 was unreachable — Oracle removed the
# 2024.2.0 SDK JAR from their CDN, so npm postinstall fails on @^2). v3 ships
# with cli-2025.2.1.jar and needs a JRE at runtime to invoke the SDK JAR.
# DO NOT purge nodejs or default-jre-headless — suitecloud shells out to both.
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates gnupg default-jre-headless && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    npm install -g @oracle/suitecloud-cli@^3 --acceptsuitecloudsdklicense && \
    apt-get purge -y --auto-remove curl gnupg && \
    rm -rf /var/lib/apt/lists/* /root/.npm

# Smoke check — fail the build if the suitecloud binary isn't on PATH (codex #14).
RUN suitecloud --version

# Copy backend application code (the build context is the repo root, so
# select backend/ explicitly).
COPY backend/ .

# Copy vendored Oracle SuiteCloud SDK skill content for RAG seeding.
# .dockerignore restricts this to oracle-vendored skills only — custom
# local skills (suitescript-engineer, etc.) stay out of the image.
COPY .claude/skills/ /app/.claude/skills/

# Create non-root user
RUN addgroup --system appuser && \
    adduser --system --ingroup appuser appuser && \
    mkdir -p /data && \
    chown -R appuser:appuser /app && \
    chown -R appuser:appuser /data
USER appuser

EXPOSE 8000

# Must equal --workers below: rate limits are fleet-wide, and the limiter's
# in-memory fallback divides them by WEB_CONCURRENCY. This image runs 2 workers
# while the dev image runs 4, so leaving it to the default silently mis-scaled
# every production ceiling. Pinned by tests/test_worker_concurrency_config.py.
ENV WEB_CONCURRENCY=2

# Default: run FastAPI with production settings
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
